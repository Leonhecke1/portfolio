    "@tsparticles/react": "^3.0.0",
    "framer-motion": "^12.38.0",
    "immer": "^11.1.3",
    "konva": "^10.2.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.2",
    "react-router-dom": "^7.13.0",
    "react-syntax-highlighter": "^16.1.0",
    "sass": "^1.97.3",
    "tailwindcss": "^4.2.2",
    "three": "^0.182.0",
    "use-image": "^1.1.4"
  },
