{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --inspect server/server.js\" --kill-others --prefix \"{name}\" --names \"vite,server\" --prefix-colors \"yellow.bold,cyan.bold\"",
